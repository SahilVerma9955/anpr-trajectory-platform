# Project configuration
PROJECT_NAME=anpr-trajectory-platform
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./data/processed/anpr.db

# Optional basic API auth
API_AUTH_ENABLED=false
API_KEY=

# Analytics defaults
FREE_FLOW_SPEED_KMH=50
DEFAULT_CAMERA_LATITUDE=28.6139
DEFAULT_CAMERA_LONGITUDE=77.2090
DEFAULT_MAP_ZOOM=11

# Video pipeline defaults
FRAME_SAMPLE_RATE=10
MODEL_CONFIDENCE=0.35
MODEL_IOU=0.50
MODEL_IMAGE_SIZE=640

# IBM Cloud placeholders
IBM_CLOUD_REGION=us-south
IBM_CLOUD_RESOURCE_GROUP=default
IBM_CLOUD_REGISTRY_NAMESPACE=your-registry-namespace
IBM_CLOUD_CODEENGINE_PROJECT=anpr-demo
IBM_CLOUD_COS_BUCKET=anpr-demo-bucket

# Kaggle
KAGGLE_USERNAME=
KAGGLE_KEY=
